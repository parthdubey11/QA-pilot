# Copy to .env and fill in. Never commit .env.
# MongoDB (inside Docker the host is "mongo"; from your own machine use mongodb://localhost:27017)
MONGO_URL=mongodb://mongo:27017
MONGO_DB=qapilot
JWT_SECRET=change-me-to-a-long-random-string
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=7
# Fernet key for encrypting test-site credentials. Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# If empty, a key is derived from JWT_SECRET (development only).
CREDENTIALS_KEY=

# LLM: gemini (default) | groq | ollama. Only the chosen provider needs a key.
LLM_PROVIDER=gemini
# Backups, tried in order when the provider above runs out of tokens (e.g. gemini or gemini,ollama).
# A backup without an API key is skipped.
LLM_FALLBACKS=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GROQ_API_KEY=
GROQ_MODEL=qwen/qwen3.8-27b
# Ollama running on your PC, as seen from inside Docker:
OLLAMA_URL=http://host.docker.internal:11434
OLLAMA_MODEL=llama3.2-vision
# Pause between LLM calls and retries on HTTP 429/5xx. Groq free tier (8k tokens/min): use 15.
LLM_MIN_INTERVAL_SECONDS=4
LLM_MAX_RETRIES=3

# Browser (worker). ACTION_DELAY_MS = pause after every action, to be gentle with the site under test.
ACTION_DELAY_MS=300
NAVIGATION_TIMEOUT_MS=20000
# Hosts the browser must never reach (SSRF guard): QA Pilot's own services and cloud metadata.
BLOCKED_TARGET_HOSTS=mongo,api,worker,frontend,caddy,metadata.google.internal,metadata

# demo-shop UI labels: v1 (default) or v2 (renamed buttons, for the self-healing demo)
DEMO_SHOP_UI_VARIANT=v1
