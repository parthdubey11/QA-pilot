# Official Playwright image: Chromium and its system libraries are preinstalled.
# Keep the tag in sync with the playwright version in requirements-worker.txt.
FROM mcr.microsoft.com/playwright/python:v1.63.0-noble

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

WORKDIR /app
COPY requirements.txt requirements-dev.txt requirements-worker.txt ./
RUN pip install --no-cache-dir -r requirements-worker.txt -r requirements-dev.txt
# Bake the RAG embedding model (all-MiniLM-L6-v2, ~80 MB) into the image instead of downloading it at runtime.
RUN python -c "from chromadb.utils.embedding_functions import ONNXMiniLM_L6_V2 as M; M(preferred_providers=['CPUExecutionProvider'])(['warm up'])"

COPY . .

CMD ["python", "-m", "worker.main"]
